# ==========================================
# MediSA - Master Environment Configuration
# ==========================================

APP_ENV=local
APP_DEBUG=true

# Host Port Mappings (Bound on your physical host machine)
HOST_FRONTEND_PORT=3005
HOST_BACKEND_PORT=8005
HOST_AI_PORT=8006
HOST_DB_PORT=5455
HOST_REDIS_PORT=6395

# PostgreSQL with pgvector Database
DB_CONNECTION=pgsql
DB_HOST=medisa-db
DB_PORT=5432
DB_DATABASE=medisa
DB_USERNAME=medisa_user
DB_PASSWORD=medisa_secret_pass

# Redis Configuration
REDIS_HOST=medisa-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Service-to-Service Internal URLs (Docker Network)
INTERNAL_BACKEND_URL=http://medisa-backend:8000
INTERNAL_AI_URL=http://medisa-ai:8000
INTERNAL_FRONTEND_URL=http://medisa-frontend:3000

# Public URLs (For Browser access)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8005/api
NEXT_PUBLIC_AI_BASE_URL=http://localhost:8006/api/v1

# AI LLM Provider Configuration
OPENAI_API_KEY=mock-key-for-local-dev
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
