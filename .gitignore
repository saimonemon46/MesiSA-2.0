# Root .gitignore for MediSA Monorepo

# Environment variables
.env
.env.local
.env.*.local
*.env

# Operating System
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/*.tsbuildinfo
frontend/.npm

# PHP / Laravel
backend/vendor/
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore
backend/storage/*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore

# Python / FastAPI
ai-service/__pycache__/
ai-service/*/__pycache__/
ai-service/*/*/__pycache__/
ai-service/.pytest_cache/
ai-service/.venv/
ai-service/venv/
ai-service/env/
ai-service/*.egg-info/
ai-service/.mypy_cache/
ai-service/.ruff_cache/

# Docker volumes / persistence local data
.docker-data/
